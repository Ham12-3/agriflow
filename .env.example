# N-ATLaS (Agriflow AI). Copy to .env.local, fill in ONE option, then run:
#   npm run ai:check

# Option A (recommended): Hugging Face Inference Endpoint running NCAIR1/N-ATLaS.
# N-ATLaS isn't on HF's shared serverless providers, so it runs on your own
# dedicated endpoint. See "N-ATLaS on Hugging Face" in README.md.
LLM_BASE_URL=https://<your-endpoint>.endpoints.huggingface.cloud/v1
LLM_MODEL=NCAIR1/N-ATLaS
HF_TOKEN=hf_your_token_here
LLM_REPETITION_PENALTY=1.12

# Option B: self-hosted vLLM  (HF_TOKEN=... vllm serve NCAIR1/N-ATLaS)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=NCAIR1/N-ATLaS

# Option C: local Ollama with the community GGUF build (CPU-friendly)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=hf.co/tosinamuda/N-ATLaS-GGUF:Q4_K_M

# Voice input (AgriTalk). Start the local speech server with `npm run asr`
# (uses Whisper; set HF_TOKEN in your shell to use the N-ATLaS Nigerian speech
# models instead, after accepting their terms on Hugging Face).
ASR_BASE_URL=http://localhost:8001/v1

# Spoken replies (YarnGPT, Nigerian voices in English, Hausa, Igbo and Yoruba).
# One-time install with `npm run tts:setup` (~2.5 GB), then start `npm run tts`.
# Without it, replies are read with the device's own voice. Optional voice
# overrides: TTS_VOICE_EN=idera, TTS_VOICE_YO=yoruba_male2, TTS_VOICE_HA=…, TTS_VOICE_IG=…
TTS_BASE_URL=http://localhost:8002/v1
